              <stringProp name="script">


log.info(&quot;Request Id in Thread --&gt;&gt;&gt;&gt;&gt; &quot; + &quot;${orderid_1}&quot;);
//log.info(&quot;Request Id in Thread --&gt;&gt;&gt;&gt;&gt; &quot; + &quot;${orderid_ALL}&quot;);
String[] orderidsplitvalues = vars.get(&quot;orderid_ALL&quot;).split(&quot;,&quot;); 
log.info(&quot;Afterspliting&quot;+orderidsplitvalues[1]);
int orderidsplitvalueslength = orderidsplitvalues.length;
log.info(&quot;----&gt;&gt;&gt;&gt;&gt; &quot; + orderidsplitvalueslength);

ArrayList orderidarray = new ArrayList();
for(int i=0;i&lt; orderidsplitvalueslength;i++)
{
	orderidarray.add(orderidsplitvalues[i]);
}
bsh.shared.orderidarray=orderidarray;
log.info(&quot;Beanshellvalues For OrderID&quot;+bsh.shared.orderidarray);



















