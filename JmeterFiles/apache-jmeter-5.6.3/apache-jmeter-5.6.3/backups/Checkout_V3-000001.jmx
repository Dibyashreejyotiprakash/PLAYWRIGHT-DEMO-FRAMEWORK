        <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">var props = org.apache.jmeter.util.JMeterUtils.getJMeterProperties();
var it = props.get(&quot;TOKEN&quot;);
log.info(&quot;BSFTOKEN==&gt;&quot;+it);
bsh.shared.token=it;
log.info(&quot;shared variable&quot;+bsh.shared.token);

var userid1 = props.get(&quot;userId&quot;);
log.info(&quot;BSFTOKEN==&gt;&quot;+userid1);
bsh.shared.userId=userid1;
log.info(&quot;shared variable&quot;+bsh.shared.userId);

var personid1 = props.get(&quot;personId&quot;);
log.info(&quot;BSFTOKEN==&gt;&quot;+personid1);
bsh.shared.personId=personid1;
log.info(&quot;shared variable&quot;+bsh.shared.personId);</stringProp>
        </BeanShellPostProcessor>
