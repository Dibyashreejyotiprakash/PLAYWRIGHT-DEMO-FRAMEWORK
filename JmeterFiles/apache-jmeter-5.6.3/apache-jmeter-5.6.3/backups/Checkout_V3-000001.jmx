        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="jp@gc - WebDriver Sampler" enabled="true">
          <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait);
var wait = new support_ui.WebDriverWait(WDS.browser, 10000);
var conditions = org.openqa.selenium.support.ui.ExpectedConditions
var actions = new org.openqa.selenium.interactions.Actions(WDS.browser)
var props = org.apache.jmeter.util.JMeterUtils.getJMeterProperties()

WDS.sampleResult.sampleStart()
WDS.browser.get(&apos;http://qaautomation.v5qa.brandmuscle.net/Login/Login.aspx&apos;);
WDS.browser.manage().window().maximize();
java.lang.Thread.sleep(10000)
var username=WDS.browser.findElement(pkg.By.id(&apos;UserName&apos;))
//username.sendKeys(&apos;kumaraswamy.mekala@brandmuscle.com&apos;);
username.sendKeys(&apos;qaatestemulate1&apos;);
//username.sendKeys(&apos;bhargava.krishna@brandmuscle.com&apos;);
var password=WDS.browser.findElement(pkg.By.id(&apos;Password&apos;))
password.sendKeys(&apos;welcome&apos;);
//password.sendKeys(&apos;dEz880YOsO&apos;);
var signBtn=WDS.browser.findElement(pkg.By.id(&apos;LoginButton&apos;));
signBtn.click();
wait.until(conditions.visibilityOfElementLocated(pkg.By.id(&apos;MainContent_ddlBusinessUnit&apos;)));
var BU=WDS.browser.findElement(pkg.By.id(&apos;MainContent_ddlBusinessUnit&apos;));
BU.sendKeys(&apos;QA&apos;);
var Admincontrolpanel=WDS.browser.findElement(pkg.By.id(&apos;PageHeader1_ucDebug_imgAdminHide&apos;));
Admincontrolpanel.click();
wait.until(conditions.visibilityOfElementLocated(pkg.By.id(&apos;PageHeader1_ucDebug_txtConfigVersion&apos;)));
var configversion=WDS.browser.findElement(pkg.By.id(&apos;PageHeader1_ucDebug_txtConfigVersion&apos;));
configversion.sendKeys(&apos;8739&apos;);
var DebugBtn=WDS.browser.findElement(pkg.By.id(&apos;PageHeader1_ucDebug_lbDebugConfig&apos;))
DebugBtn.click();
java.lang.Thread.sleep(10000)
wait.until(conditions.visibilityOfElementLocated(pkg.By.id(&apos;LinkedShoppingCartTable&apos;)));
java.lang.Thread.sleep(20000)
var NoofOrderLines=WDS.browser.findElement(pkg.By.id(&apos;ShoppingCartOrderLines&apos;)).text;
WDS.log.info(&quot;No.Of OrderLines====&gt;&quot;+NoofOrderLines);
if((Number(NoofOrderLines)&lt;2))
{
	var keywordsearch=WDS.browser.findElement(pkg.By.id(&apos;PageHeader1_txtPgHeaderKeywordSearch&apos;));
	keywordsearch.sendKeys([&apos;checkout&apos;]);
	java.lang.Thread.sleep(2000)
	keywordsearch.sendKeys(org.openqa.selenium.Keys.ENTER);
	//var btnGo=WDS.browser.findElement(pkg.By.xpath(&apos;//input[@id=&quot;PageHeader1_btnPgHeaderKeywordSearchGo&quot;]&apos;));
	//btnGo.click();
	java.lang.Thread.sleep(10000)
	var btnAddShoppingCart=WDS.browser.findElement(pkg.By.xpath(&apos;(//input[@id=&quot;btnAddToShoppingCart&quot;])[1]&apos;))
	btnAddShoppingCart.click();
	java.lang.Thread.sleep(10000)

	var btnAddShoppingCart2=WDS.browser.findElement(pkg.By.xpath(&apos;(//input[@id=&quot;btnAddToShoppingCart&quot;])[2]&apos;))
	btnAddShoppingCart2.click();
	java.lang.Thread.sleep(20000)

}
var viewcart = WDS.browser.findElement(pkg.By.id(&apos;LinkedShoppingCartTable&apos;));
actions.moveToElement(viewcart).build().perform()
wait.until(conditions.visibilityOfElementLocated(pkg.By.id(&apos;ViewShoppingCart&apos;)));
var viewcartBtn=WDS.browser.findElement(pkg.By.id(&apos;ViewShoppingCart&apos;));
if(viewcartBtn.isDisplayed)
{
	WDS.log.info(&quot;clicking&quot;);
}
else
WDS.log.info(&quot;Not available&quot;);
viewcartBtn.click();
java.lang.Thread.sleep(20000)
wait.until(conditions.visibilityOfElementLocated(pkg.By.xpath(&apos;//button[contains(text(),&quot;Save for later&quot;)]&apos;)));
//var checkout=WDS.browser.findElement(pkg.By.id(&apos;//button[contains(text(),&quot;Checkout&quot;)]&apos;))

//checkout.click();
//java.lang.Thread.sleep(20000)
//WDS.browser.navigate().refresh();
//java.lang.Thread.sleep(20000)
var tokenvalue = WDS.browser.executeScript(&quot;return window.sessionStorage.getItem(&apos;access_token&apos;);&quot;) 
WDS.log.info(&quot;token====&gt;&quot;+tokenvalue);
props.put(&quot;TOKEN&quot;,tokenvalue);

var V5Auth=WDS.browser.executeScript(&quot;return window.sessionStorage.getItem(&apos;V5Auth&apos;);&quot;)
var V5AuthSplitValues=V5Auth.split(&apos;,&apos;);
var personId= (V5AuthSplitValues[1].split(&apos;:&apos;))[1];
WDS.log.info(&quot;personId====&gt;&quot;+personId);
props.put(&quot;personId&quot;,personId);

var userId= (V5AuthSplitValues[3].split(&apos;:&apos;))[1];
WDS.log.info(&quot;userId====&gt;&quot;+userId);
props.put(&quot;userId&quot;,userId);


WDS.sampleResult.sampleEnd()
</stringProp>
