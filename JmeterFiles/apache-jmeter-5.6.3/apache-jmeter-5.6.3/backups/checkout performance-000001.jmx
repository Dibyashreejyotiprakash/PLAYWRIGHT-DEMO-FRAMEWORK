          <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="ACE_Launch and login stage" enabled="true">
            <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium);
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait);
var wait = new support_ui.WebDriverWait(WDS.browser, 5000);
var props = org.apache.jmeter.util.JMeterUtils.getJMeterProperties()
var select=JavaImporter(org.openqa.selenium.support.ui.Select);

WDS.sampleResult.sampleStart()

java.lang.Thread.sleep(7000)
WDS.browser.get(&apos;https://acehardware.v5stage.brandmuscle.net/Login/Login.aspx&apos;)
var titlep=WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt;&quot;+WDS.browser.getTitle());

var username=WDS.browser.findElement(pkg.By.id(&apos;UserName&apos;));
username.sendKeys(&apos;${USERNAME}&apos;);
var password=WDS.browser.findElement(pkg.By.id(&apos;Password&apos;));
password.sendKeys(&apos;${PASSWORD}&apos;);
var lgnbtn=WDS.browser.findElement(pkg.By.id(&apos;LoginButton&apos;));
lgnbtn.click();
java.lang.Thread.sleep(7000)
wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//span[text()=&apos;Search Media Options&apos;]&quot;)))

//var element = WDS.browser.findElement(org.openqa.selenium.By.name(&apos;ctl00$MainContent$ddlBusinessUnit&apos;))
//var select = new org.openqa.selenium.support.ui.Select(element)
//select.selectByVisibleText(&apos;ACE Hardware&apos;)
//java.lang.Thread.sleep(5000)

var titlep=WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt;&quot;+WDS.browser.getTitle());

WDS.sampleResult.sampleEnd()
</stringProp>
            <stringProp name="WebDriverSampler.parameters"></stringProp>
            <stringProp name="WebDriverSampler.language">javascript</stringProp>
          </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
          <hashTree/>
          <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="ACE_Search and Select Template" enabled="true">
            <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium);
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait);
var wait = new support_ui.WebDriverWait(WDS.browser, 5000);
var props = org.apache.jmeter.util.JMeterUtils.getJMeterProperties()
var select=JavaImporter(org.openqa.selenium.support.ui.Select);

WDS.sampleResult.sampleStart()

var templateNames = [&apos;Ace Rewards Military Double Points Poster&apos;,&apos;PK- 865400 2022 Outdoor Power Equipment Catalog&apos;,&apos;PK 240390 B2B Pro Paint Solutions Catalog&apos;,&apos;PK - 832500 2022 Outdoor Living Catalog&apos;,&apos;PK - 865300 2022 Grilling Catalog&apos;,&apos;BG - 118425 Clear Tape Strips&apos;,&apos;BG - 117122 Red Ribbon with the Ace Logo&apos;,&apos;B2B Lead Generation Tearpad&apos;,&apos;EA - 244730 Ace Rewards End Cap&apos;,&apos;EA - 244640 Rewards Star Window Cling&apos;];

WDS.log.info(&quot;titlep====&gt;&quot;+templateNames.length);

for(var i = 0; i &lt; templateNames.length; i++)
	
	{
			wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//iframe[@id=&apos;ifVFPSite&apos;]&quot;)))
			
			// Switching to frame
			var iframe = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//iframe[@id=&apos;ifVFPSite&apos;]&quot;));
			WDS.browser.switchTo().frame(iframe);

			var closePopup = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[@class=&apos;close&apos;]&quot;));
			closePopup.click();

			var element = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;txtkeyword&apos;]&quot;));
			element.sendKeys(templateNames[i]);

			// Click On Go Button to retireve Search Results

			var go_btn = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//button[@id=&apos;btnGo&apos;]&quot;));
			go_btn.click();

			// Switching back to default page
			WDS.browser.switchTo().defaultContent();

			wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//div[contains(text(),&apos;Favorites&apos;)]&quot;)))

			// Click On Searched template from Grid
			var searchResult = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(text(),&apos;&quot;+templateNames[i]+&quot;&apos;)]&quot;));
			searchResult.click();
			
			for(var j = 0; j &lt; 5; j++)
			{
				//Click On Add to Cart
				var addCart_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.id(&apos;btnAddToShoppingCart&apos;)))
				addCart_btn.click();

				wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//span[@id=&apos;pdpAddedToCartLabel&apos;]&quot;)))
				
			}
			
			// Click On Home

			wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//body/form[@id=&apos;Form1&apos;]/div[@id=&apos;PageHeader&apos;]/div[5]/a[1]/img[1]&quot;)))
			
			var homePage_icon = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//body/form[@id=&apos;Form1&apos;]/div[@id=&apos;PageHeader&apos;]/div[5]/a[1]/img[1]&quot;));
			homePage_icon.click();

			wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//span[contains(text(),&apos;Search Media Options&apos;)]&quot;)))
		
	}

WDS.sampleResult.sampleEnd()
</stringProp>
            <stringProp name="WebDriverSampler.parameters"></stringProp>
            <stringProp name="WebDriverSampler.language">javascript</stringProp>
          </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
          <hashTree/>
          <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="ACE_View cart item" enabled="true">
            <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium); //WebDriver classes
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait); //WebDriver classes
var wait = new support_ui.WebDriverWait(WDS.browser, 70000);

WDS.sampleResult.sampleStart()

// Click On Cart Icon
var cart_icon = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//tbody/tr[2]/td[1]/img[1]&quot;)))
cart_icon.click();

// Click On View Shopping cart
wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//input[@id=&apos;ViewShoppingCart&apos;]&quot;)))

var viewCart_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//input[@id=&apos;ViewShoppingCart&apos;]&quot;)))
viewCart_btn.click();

// waiting till checkout utton is present
wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//button[contains(text(),&apos;Checkout&apos;)]&quot;)))

WDS.sampleResult.sampleEnd()</stringProp>
