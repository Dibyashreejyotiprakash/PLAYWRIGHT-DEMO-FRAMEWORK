            <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium); //WebDriver classes
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait); //WebDriver classes
var wait = new support_ui.WebDriverWait(WDS.browser, 70000);

WDS.sampleResult.sampleStart()

// Click On Cart Icon
var cart_icon = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//tbody/tr[2]/td[1]/img[1]&quot;)))
cart_icon.click();

// Click On View Shopping cart
wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//input[@id=&apos;ViewShoppingCart&apos;]&quot;)))

var viewCart_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//input[@id=&apos;ViewShoppingCart&apos;]&quot;)))
viewCart_btn.click();

// waiting till checkout utton is present
wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//button[contains(text(),&apos;Checkout&apos;)]&quot;)))

