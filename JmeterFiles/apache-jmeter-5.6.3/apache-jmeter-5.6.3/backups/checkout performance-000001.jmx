            <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium); //WebDriver classes
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait); //WebDriver classes
var wait = new support_ui.WebDriverWait(WDS.browser, 70000);

WDS.sampleResult.sampleStart()

//var orderName_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@class=&apos;ng-pristine ng-invalid ng-touched&apos;]&quot;));
//orderName_tb.sendKeys(&apos;Test&apos;);

var checkout_btn = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//button[contains(text(),&apos;Checkout&apos;)]&quot;));
checkout_btn.click();

wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;(//div[@class=&apos;pretty p-default p-round&apos;])[1]&quot;)))

//java.lang.Thread.sleep(10000)
var button = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//button[contains(text(),&apos;Checkout&apos;)]&quot;)))
button.click();

//wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//div[@class=&apos;alert orderline-coop&apos;]&quot;)))

// Credit Card Amount

var creditCardTotal_txt = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;(//div[@class=&apos;col-6 label&apos;])[4]//following::div[1]&quot;));
WDS.log.info(&quot;CreditCardTotal====&gt;&quot;+creditCardTotal_txt.getText());

if(creditCardTotal_txt.getText() !=  &quot;$0.00&quot;)
{
	// Enter Credit Card Details 

	wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//span[contains(text(),&apos;Credit card&apos;)]&quot;)))

	var creditCardName_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;cardHolderName&apos;]&quot;));
	creditCardName_tb.sendKeys(&quot;Test&quot;);

	var creditCardNum_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;cardNumber&apos;]&quot;));
	creditCardNum_tb.sendKeys(&quot;4242424242424242&quot;);

	var expMonth_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;expirationMonth&apos;]&quot;));
	expMonth_tb.sendKeys(&quot;01&quot;);

	var expYear_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;expirationYear&apos;]&quot;));
	expYear_tb.sendKeys(&quot;25&quot;);

	var securityCode_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;securityCode&apos;]&quot;));
	securityCode_tb.sendKeys(&quot;123&quot;);
}


//wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//span[contains(text(),&apos;Corporate Billing&apos;)]&quot;)))

var termsAndCon_checkbox = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[@class=&apos;pretty p-icon p-smooth bm-checkbox&apos;]&quot;));
termsAndCon_checkbox.click();

WDS.sampleResult.sampleEnd()</stringProp>
