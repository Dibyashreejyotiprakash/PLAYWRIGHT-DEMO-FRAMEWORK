            <stringProp name="WebDriverSampler.script">var pkg = JavaImporter(org.openqa.selenium);
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait);
var wait = new support_ui.WebDriverWait(WDS.browser, 5000);
var props = org.apache.jmeter.util.JMeterUtils.getJMeterProperties()
var select=JavaImporter(org.openqa.selenium.support.ui.Select);

WDS.sampleResult.sampleStart()

//var templateNames = [&quot;Flag 5&apos;&apos; X 3&apos;&apos; With Logo Outdoor Indoor Life Span 90 Days&quot;,&quot;2&apos;&apos; x 3&apos;&apos; Agent, Post-it Note&quot;,&quot;Flag 8&apos;&apos; X 5&apos;&apos; With Logo Outdoor Indoor Life Span 90 Days&quot;,&quot;Flag 6&apos;&apos; X 4&apos;&apos; With Logo Outdoor Indoor Life Span 90 Days&quot;,&quot;Rush Resize Request&quot;,&quot;Payment for Rush Resize Request&quot;,&quot;Payment for Team Member Cutout Photo Request&quot;];

var templateNames = [&apos;Color Photo, Letterhead&apos;,&apos;Small Business Poster - SMZ-80062&apos;,&apos;Color Photo, Regular Seal, White #10 Window Envelope&apos;,&apos;Small Business Poster Coffee Shop - SMZ-80081&apos;,&apos;2HBC9152 - Thanksgiving Card Spanish - Hallmark Boxed Card&apos;,&apos;N-24140 - Wall Frames for Posters&apos;];
WDS.log.info(&quot;titlep====&gt;&quot;+templateNames.length);

for(var i = 0; i &lt; (&apos;${PRODUCT_LINES}&apos;); i++)
	
	{
			wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//iframe[@id=&apos;ifVFPSite&apos;]&quot;)))
			
			// Switching to frame
			var iframe = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//iframe[@id=&apos;ifVFPSite&apos;]&quot;));
			WDS.browser.switchTo().frame(iframe);	

			var element = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;txtkeyword&apos;]&quot;));
			element.sendKeys(templateNames[i]);

			// Click On Go Button to retireve Search Results

			var go_btn = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//button[@id=&apos;btnGo&apos;]&quot;));
			go_btn.click();

			// Switching back to default page
			WDS.browser.switchTo().defaultContent();

			wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//div[contains(text(),&apos;Marketing For/LOB&apos;)]&quot;)))

			// Click On Searched template from Grid
			//var searchResult = WDS.browser.findElement(org.openqa.selenium.By.xpath(&apos;//div[contains(text(),&quot;&apos;+templateNames[i]+&apos;&quot;)]&apos;));
			
			var searchResult = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(text(),&apos;&quot;+templateNames[i]+&quot;&apos;)]&quot;));
			searchResult.click();

			// Checking for POS Template and Building the Add
			if(templateNames[i] == &apos;Color Photo, Letterhead&apos;,&apos;Color Photo, Regular Seal, White #10 Window Envelope&apos;)
			{

				var templateName = templateNames[i];

				switch(templateName)
				{
				case &quot;Color Photo, Letterhead&quot;:
										
					// Click On Build
				
					var build_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//button[@id=&apos;btnValidate&apos;]&quot;)))
					build_btn.click();

					// Select Location Display
					
					var locationDisplay_radio = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//input[@id=&apos;radio1&apos;]&quot;)))
					locationDisplay_radio.click();

					var continue_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//input[@id=&apos;btnContinue&apos;]&quot;)))
					continue_btn.click();
				
					// Select Locations for your Material
					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;(//tr[@class=&apos;sslEnabledLocation&apos;])[1]&quot;)))
					var selectLocation = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;(//tr[@class=&apos;sslEnabledLocation&apos;])[1]&quot;));			
					selectLocation.click();

					// Click On Continue
				
					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;(//img[@class=&apos;locationSortableDelete&apos;])[2]&quot;)))
					java.lang.Thread.sleep(1000);
			
					var continue_submit = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//input[@value=&apos;Continue&apos;]&quot;)))
					continue_submit.click();

					// Wait Till View Proof Button is clickable
					//wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.id(&apos;btnProof&apos;)));

					// Select Taglines
					
					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//div[contains(text(),&apos;Tagline or ‘We Speak’&apos;)]&quot;)))
					wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//input[@id=&apos;radio_CTA_Choice_0&apos;]&quot;)))
				
					var tagLineRadio = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;radio_CTA_Choice_0&apos;]&quot;)) 		
					tagLineRadio.click();

					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//select[@id=&apos;select_CTA_Choice_2&apos;]&quot;)))
					var element = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//select[@id=&apos;select_CTA_Choice_2&apos;]&quot;));
					var select = new org.openqa.selenium.support.ui.Select(element);
					select.selectByIndex(1);

					// Select Imprint Lines

					var selectImprintLines = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(text(),&apos;Select Imprint Lines&apos;)]&quot;)) 		
					selectImprintLines.click();

					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//input[@id=&apos;radio_Choice_State_Lic_Agent_1_0&apos;]&quot;)))
					var imprintLine_radio = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;radio_Choice_State_Lic_Agent_1_0&apos;]&quot;));
					imprintLine_radio.click();

					// Line2 
					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//select[@id=&apos;select_Imprint_Line_1&apos;]&quot;)))
					var element = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//select[@id=&apos;select_Imprint_Line_1&apos;]&quot;));
					var select = new org.openqa.selenium.support.ui.Select(element);
					select.selectByIndex(1);

					// Line5 
					wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(pkg.By.xpath(&quot;//select[@id=&apos;select_Imprint_Line_5&apos;]&quot;)))
					var element = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//select[@id=&apos;select_Imprint_Line_5&apos;]&quot;));
					var select = new org.openqa.selenium.support.ui.Select(element);
					select.selectByIndex(1);

					var adName_tb = WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//input[@id=&apos;MainContent_rptrTemplates_txtTemplateName_0&apos;]&quot;));
					adName_tb.sendKeys(&apos;Test Template&apos;);

					break;
				
				case &quot;Color Photo, Regular Seal, White #10 Window Envelope&quot;:

					// Click On Build
				
					var build_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//button[@id=&apos;btnValidate&apos;]&quot;)))
					build_btn.click();

