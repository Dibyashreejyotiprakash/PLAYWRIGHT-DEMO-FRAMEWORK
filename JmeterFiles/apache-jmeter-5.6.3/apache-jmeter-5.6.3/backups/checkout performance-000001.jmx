var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui);
var support_ui = JavaImporter(org.openqa.selenium.support.ui.WebDriverWait); //WebDriver classes
var wait = new support_ui.WebDriverWait(WDS.browser, 70000);

WDS.sampleResult.sampleStart()
// Click on Place order button
var placeOrder_btn = wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//button[contains(text(),&apos;Place Order&apos;)]&quot;)))
placeOrder_btn.click();

wait.until(pkg.ExpectedConditions.elementToBeClickable(pkg.By.xpath(&quot;//div[contains(text(),&apos;Thank you for your order&apos;)]&quot;)))

WDS.log.info(&quot;Order Placed Successfully with User ====&gt;&quot;+&apos;${USERNAME}&apos;);

