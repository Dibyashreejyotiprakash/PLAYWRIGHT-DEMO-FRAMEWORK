        <hashTree/>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="PLP_page_Pagination" enabled="true">
          <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
import org.openqa.selenium.Keys
import org.openqa.selenium.interactions.Actions
import org.openqa.selenium.JavascriptExecutor

WDS.sampleResult.sampleStart()

// Pause for 7 seconds
Thread.sleep(5000)

def void waitForElementVisibility(By locator) {
WebDriverWait wait = new WebDriverWait(WDS.browser, 60)

    // Wait for the element to be visible using JavaScript
wait.until { driver -&gt;
        ((Boolean) ((JavascriptExecutor) driver)
            .executeScript(&quot;return arguments[0].offsetParent !== null;&quot;, driver.findElement(locator)))
    }
}

//1 Verify the Result count afte Navigation to PLP
By PLPresultCount1 = By.xpath(&quot;//span[@class=&apos;resultsCount&apos;]&quot;)
waitForElementVisibility(PLPresultCount1)

Thread.sleep(3000)


//pagination 48 
By PageNation48 = By.xpath(&quot;//div[@class=&apos;page-size-link-container&apos;]//a[text() =&apos; 48 &apos;]&quot;)
waitForElementVisibility(PageNation48)
WDS.browser.findElement(PageNation48).click()

//Verfiy the Result count after clicking on 48
By PLPresultCount2 = By.xpath(&quot;//span[@class=&apos;resultsCount&apos;]&quot;)
waitForElementVisibility(PLPresultCount2)

Thread.sleep(3000)


//96
//pagination 96
By PageNation96 = By.xpath(&quot;//div[@class=&apos;page-size-link-container&apos;]//a[text() =&apos; 96 &apos;]&quot;)
waitForElementVisibility(PageNation96)
WDS.browser.findElement(PageNation96).click()

//Verfiy the Result count after clicking on 48
By PLPresultCount3 = By.xpath(&quot;//span[@class=&apos;resultsCount&apos;]&quot;)
waitForElementVisibility(PLPresultCount3)


Thread.sleep(3000)

//24
//pagination 24
By PageNation24 = By.xpath(&quot;//div[@class=&apos;page-size-link-container&apos;]//a[text() =&apos; 24 &apos;]&quot;)
waitForElementVisibility(PageNation24)
WDS.browser.findElement(PageNation24).click()

//Verfiy the Result count after clicking on 48
By PLPresultCount4 = By.xpath(&quot;//span[@class=&apos;resultsCount&apos;]&quot;)
waitForElementVisibility(PLPresultCount4)
Thread.sleep(5000)

WDS.sampleResult.sampleEnd()</stringProp>
