        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="PLP_to_PDP" enabled="true">
          <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
import org.openqa.selenium.Keys
import org.openqa.selenium.interactions.Actions
import org.openqa.selenium.JavascriptExecutor

WDS.sampleResult.sampleStart()

// Pause for 7 seconds
Thread.sleep(5000)

def void waitForElementVisibility(By locator) {
WebDriverWait wait = new WebDriverWait(WDS.browser, 60)

    // Wait for the element to be visible using JavaScript
wait.until { driver -&gt;
        ((Boolean) ((JavascriptExecutor) driver)
            .executeScript(&quot;return arguments[0].offsetParent !== null;&quot;, driver.findElement(locator)))
    }
}

//clickon build button in PLP first item

By fistItemPLP = By.xpath(&quot;(//div[@class=&apos;title-container&apos;])[1]&quot;)
waitForElementVisibility(fistItemPLP)
WDS.browser.findElement(fistItemPLP).click()

//wait for plp to load

Thread.sleep(5000)

By pdpbuildbutton_cb = By.xpath(&quot;//button[@id = &apos;btnValidate&apos;]&quot;)
waitForElementVisibility(pdpbuildbutton_cb)

//pdpBuildbtn.click()

WDS.sampleResult.sampleEnd()

</stringProp>
          <stringProp name="WebDriverSampler.parameters"></stringProp>
          <stringProp name="WebDriverSampler.language">groovy</stringProp>
        </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
        <hashTree/>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="PDP_to_ComposerPage" enabled="true">
          <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
import org.openqa.selenium.Keys
import org.openqa.selenium.interactions.Actions
import org.openqa.selenium.JavascriptExecutor

WDS.sampleResult.sampleStart()

// Pause for 7 seconds
Thread.sleep(5000)
WebDriverWait wait = new WebDriverWait(WDS.browser, 5)

By pdpBuildbtn_cb = By.xpath(&quot;//button[@id = &apos;btnValidate&apos;]&quot;)
WebElement pdpBuildbtn = wait.until(ExpectedConditions.visibilityOfElementLocated(pdpBuildbtn_cb))
pdpBuildbtn.click()


Thread.sleep(4000)


try{

//sub template  1 location templte

By selectoneLoc = By.xpath(&quot;//input[@id=&apos;radio1&apos;]&quot;)
WebElement selectoneLocwait = wait.until(ExpectedConditions.visibilityOfElementLocated(selectoneLoc))
selectoneLocwait.click()

//continue sub template page
By btncontineSubtmppage = By.xpath(&quot;//input[@id=&apos;btnContinue&apos;]&quot;)
WebElement btncontineSubtmppagewait = wait.until(ExpectedConditions.visibilityOfElementLocated(btncontineSubtmppage))
btncontineSubtmppagewait.click()

Thread.sleep(4000)
	
}
catch(error ){
WDS.log.info(&quot;Subtemplate page is not avilable&quot;+error)
	
}

Thread.sleep(3000)


//select location page.
By selectLocation = By.xpath(&quot;//tbody/tr[7]/td[1]&quot;)
WebElement selectLocationwait = wait.until(ExpectedConditions.visibilityOfElementLocated(selectLocation))
selectLocationwait.click()


//location continuew button 
By continuelocbtn = By.xpath(&quot;//input [@id=&apos;btnContinue&apos;]&quot;)
WebElement continuelocbtnwait = wait.until(ExpectedConditions.visibilityOfElementLocated(continuelocbtn))
continuelocbtnwait.click()


Thread.sleep(10000)

// wait till Build An Add label is displayed
By buildanadd_lbl = By.xpath(&quot;//h1[contains(text(),&apos;Build an Ad&apos;)]&quot;)
WebElement element1 = wait.until(ExpectedConditions.visibilityOfElementLocated(buildanadd_lbl))

Thread.sleep(3000)

WDS.sampleResult.sampleEnd()</stringProp>
