          <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="Click On Cart" enabled="true">
            <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
import org.openqa.selenium.Keys
import org.openqa.selenium.interactions.Actions
import org.openqa.selenium.JavascriptExecutor

WDS.sampleResult.sampleStart()

WebDriverWait wait = new WebDriverWait(WDS.browser, 5)

By cartIcon = By.xpath(&quot;//*[@id=&apos;cartimage&apos;]&quot;)
WebElement cartIcon_web = wait.until(ExpectedConditions.visibilityOfElementLocated(cartIcon))
cartIcon_web.click()

By view_CartIcon = By.xpath(&quot;//*[@id=&apos;ViewShoppingCart&apos;]&quot;)
WebElement view_cartIcon_web = wait.until(ExpectedConditions.visibilityOfElementLocated(view_CartIcon))
view_cartIcon_web.click()


Thread.sleep(5000)
WDS.sampleResult.sampleEnd()</stringProp>
