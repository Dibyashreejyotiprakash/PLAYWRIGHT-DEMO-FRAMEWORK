          <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="SF_login" enabled="true">
            <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
//import org.openqa.selenium.CookiePolicy

WDS.sampleResult.sampleStart()
Thread.sleep(5000)
////chrome options
//ChromeOptions options = new ChromeOptions()
//options.addArguments(&quot;--disable-third-party-cookies&quot;)
//
//WDS.browser = new ChromeDriver(options)
//WDS.browser.manage().cookie().setCookiePolicy(CookiePolicy.REJECT_THIRD_PARTY_COOKIES)



// Navigate to the login page
WDS.browser.get(&apos;https://statefarm.v5stage.brandmuscle.net/Login/Login.aspx?ReturnUrl=%2f%3fIsSPSSO%3dtrue&amp;IsSPSSO=true&apos;)

// Log the title of the page
def titlep = WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt; ${titlep}&quot;)

// Find and fill the username field
WebElement username = WDS.browser.findElement(By.id(&apos;UserName&apos;))
username.sendKeys(&apos;qaatestemulate1&apos;)

// Find and fill the password field
WebElement password = WDS.browser.findElement(By.id(&apos;Password&apos;))
password.sendKeys(&apos;Password@123&apos;)

// Find and click the login button
WebElement lgnbtn = WDS.browser.findElement(By.id(&apos;LoginButton&apos;))
lgnbtn.click()

// Pause for 7 seconds
Thread.sleep(7000)

// Wait until the &apos;Home&apos; element is clickable
WebDriverWait wait = new WebDriverWait(WDS.browser, 5)
//wait.until(ExapectedConditions.elementToBeClickable(By.xpath(&quot;//span[text()=&apos;Home&apos;]&quot;)))

Select DDSelectBUAT =new Select(WDS.browser.findElement(By.xpath(&quot;//select[@id=&apos;MainContent_ddlBusinessUnit&apos;]&quot;)))
DDSelectBUAT.selectByVisibleText(&quot;State Farm&quot;)

// Pause for 5 seconds
Thread.sleep(5000)

// Log the title of the page again
titlep = WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt; ${titlep}&quot;)

WDS.sampleResult.sampleEnd()

</stringProp>
            <stringProp name="WebDriverSampler.parameters"></stringProp>
            <stringProp name="WebDriverSampler.language">groovy</stringProp>
          </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
          <hashTree/>
          <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="UserEmulation" enabled="true">
            <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
import org.openqa.selenium.Keys
import org.openqa.selenium.interactions.Actions
import org.openqa.selenium.JavascriptExecutor

WDS.sampleResult.sampleStart()

// Pause for 7 seconds
Thread.sleep(5000)
WebDriverWait wait = new WebDriverWait(WDS.browser, 5)

By EmulationLink_cb = By.xpath(&quot;//div[text()=&apos;Emulate User&apos;]&quot;)
WebElement EmulationLink = wait.until(ExpectedConditions.visibilityOfElementLocated(EmulationLink_cb))
EmulationLink.click()

By EnterUsername_cb = By.xpath(&quot;//*[@id=&apos;s2id_autogen1&apos;]&quot;)

WebElement EnterUsername = wait.until(ExpectedConditions.visibilityOfElementLocated(EnterUsername_cb))
WDS.log.info(&quot;Emulated by user name  ====&gt; ${emulatename}&quot;)
EnterUsername.sendKeys(&quot;${emulatename}&quot;)


By selctUserName_cb = By.xpath(&quot;//div[@class = &apos;userEmulationRowGroup&apos;]//div[text()=&apos;${emulatename}&apos;]&quot;)
WebElement selectUserName = wait.until(ExpectedConditions.visibilityOfElementLocated(selctUserName_cb))
selectUserName.click()



WebElement emulatebtn = WDS.browser.findElement(By.xpath(&quot;//input[@id=&apos;emulationButton&apos;]&quot;))
emulatebtn.click()

WDS.sampleResult.sampleEnd()

</stringProp>
