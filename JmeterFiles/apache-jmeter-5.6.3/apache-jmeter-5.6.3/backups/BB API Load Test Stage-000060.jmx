        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="ADMINWEBDEV" enabled="true">
          <stringProp name="WebDriverSampler.script">import org.openqa.selenium.By
import org.openqa.selenium.WebDriver
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait
import org.openqa.selenium.support.ui.ExpectedConditions
import org.openqa.selenium.support.ui.Select
import org.apache.jmeter.util.JMeterUtils
//import org.openqa.selenium.CookiePolicy

WDS.sampleResult.sampleStart()
Thread.sleep(5000)
////chrome options
//ChromeOptions options = new ChromeOptions()
//options.addArguments(&quot;--disable-third-party-cookies&quot;)
//
//WDS.browser = new ChromeDriver(options)
//WDS.browser.manage().cookie().setCookiePolicy(CookiePolicy.REJECT_THIRD_PARTY_COOKIES)



// Navigate to the login page
WDS.browser.get(&apos;https://admintool.v5stage.brandmuscle.net/Login/Login.aspx&apos;)
Thread.sleep(7000)

// Log the title of the page
def titlep = WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt; ${titlep}&quot;)

// Find and fill the username field
WebElement username = WDS.browser.findElement(By.id(&apos;MainContent_LoginCentiv_UserName&apos;))
username.sendKeys(&apos;Dibyashree.Jyoti@brandmuscle.com&apos;)

// Find and fill the password field
WebElement password = WDS.browser.findElement(By.id(&apos;MainContent_LoginCentiv_Password&apos;))
password.sendKeys(&apos;j3RNeVpebd@u&apos;)

// Find and click the login button
WebElement lgnbtn = WDS.browser.findElement(By.id(&apos;MainContent_LoginCentiv_btnLogin&apos;))
lgnbtn.click()

// Pause for 7 seconds
Thread.sleep(7000)

// Wait until the &apos;Home&apos; element is clickable
WebDriverWait wait = new WebDriverWait(WDS.browser, 5)
//wait.until(ExapectedConditions.elementToBeClickable(By.xpath(&quot;//span[text()=&apos;Home&apos;]&quot;)))

Select DDSelectBUAT =new Select(WDS.browser.findElement(By.xpath(&quot;//select[@id=&apos;MainContent_ddlBusinessUnit&apos;]&quot;)))
DDSelectBUAT.selectByVisibleText(&quot;Admin Tool&quot;)

// Pause for 5 seconds
Thread.sleep(7000)

// Click on Select Bu

WebElement selectbu = WDS.browser.findElement(By.xpath(&apos;//*[text()=&apos;Select Business Unit&apos;]&apos;))
selectbu.click()


Select DDSelectBUAT1 =new Select(WDS.browser.findElement(By.xpath(&quot;//select[@id=&apos;MainContent_MainContent_drpBusinessUnit&apos;]&quot;)))
DDSelectBUAT1.selectByVisibleText(&quot;QA&quot;)

WebElement submitbtn = WDS.browser.findElement(By.id(&apos;MainContent_MainContent_btnSubmit&apos;))
submitbtn.click()

Thread.sleep(3000)

//WDS.browser.get(&apos;${url}&apos;)

WDS.browser.get(&apos;https://admintool.v5stage.brandmuscle.net/Admin/Configuration/ConfigVersion.aspx&apos;)
Thread.sleep(3000)

WDS.browser.get(&apos;https://admintool.v5stage.brandmuscle.net/Admin/FileManager/Default.aspx&apos;)

// Log the title of the page again
titlep = WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt; ${titlep}&quot;)

WDS.sampleResult.sampleEnd()

</stringProp>
