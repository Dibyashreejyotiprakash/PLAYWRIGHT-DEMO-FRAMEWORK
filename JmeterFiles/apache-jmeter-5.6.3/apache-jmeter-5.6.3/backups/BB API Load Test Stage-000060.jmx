WDS.sampleResult.sampleStart()
Thread.sleep(7000)

// Navigate to the login page
WDS.log.info(&quot;Url====&gt; ${Url}&quot;)
WDS.browser.get(&quot;${Url}&quot;)
// Log the title of the page
def loginpagetitle = WDS.browser.getTitle()
WDS.log.info(&quot;loginpagetitle====&gt; ${loginpagetitle}&quot;)

def currentUrl = WDS.browser.getCurrentUrl()
WDS.log.info(&quot;Current page URL: ${currentUrl}&quot;)
Thread.sleep(4000)
// Compare the current URL with a given URL
def expectedUrl = &quot;${Url}&quot;  // Replace with your expected URL
if (currentUrl.equals(expectedUrl)) {
    WDS.log.info(&quot;Current page URL matches the expected URL. Continuing...&quot;)
    // Perform actions you need when the URL matches
} else {
    WDS.log.info(&quot;Current page URL does not match the expected URL. Navigating to a new URL...&quot;)

    // Navigate to a new URL
    WDS.browser.get(&quot;${Url}&quot;)  // Replace &quot;${newUrl}&quot; with the actual URL you want to navigate to
    // Optionally, you may need to wait for elements on the new page to load
}

// Find and fill the username field
WebElement username = WDS.browser.findElement(By.id(&apos;UserName&apos;))
username.sendKeys(&apos;qaautomation&apos;)

// Find and fill the password field
WebElement password = WDS.browser.findElement(By.id(&apos;Password&apos;))
password.sendKeys(&apos;4x|76bH.&apos;)

// Find and click the login button
WebElement lgnbtn = WDS.browser.findElement(By.id(&apos;LoginButton&apos;))
lgnbtn.click()

// Pause for 7 seconds
Thread.sleep(7000)

// Wait until the &apos;Home&apos; element is clickable
WebDriverWait wait = new WebDriverWait(WDS.browser, 50)
//wait.until(ExapectedConditions.elementToBeClickable(By.xpath(&quot;//span[text()=&apos;Home&apos;]&quot;)))

Select DDSelectBUAT =new Select(WDS.browser.findElement(By.xpath(&quot;//select[@id=&apos;MainContent_ddlBusinessUnit&apos;]&quot;)))
DDSelectBUAT.selectByVisibleText(&quot;State Farm&quot;)

// Pause for 5 seconds
Thread.sleep(5000)

// Log the title of the page again
titlep = WDS.browser.getTitle()
WDS.log.info(&quot;titlep====&gt; ${titlep}&quot;)

WDS.sampleResult.sampleEnd()</stringProp>
